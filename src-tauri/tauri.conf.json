{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Diffora",
  "version": "0.1.0",
  "identifier": "com.engineone.diffora",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "Diffora", "width": 1200, "height": 800, "minWidth": 720, "minHeight": 540 }],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": { "active": false, "icon": ["icons/256x256.png", "icons/icon.ico"] }
}
